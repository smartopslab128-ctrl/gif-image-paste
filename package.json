{
  "name": "gif-image-paste-tool",
  "version": "0.1.0",
  "description": "Collect GIFs and images from anywhere, paste them anywhere. Always-on-top desktop tool.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win --config.win.target=portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.gifpaste.tool",
    "productName": "GIF & Image Paste",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "styles.css", "icon.png", "package.json"],
    "icon": "icon.png",
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
